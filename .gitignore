# Python virtual environment（Firebase function 用，不該 commit）
venv/
functions/venv/
**/venv/

# Python 快取
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Firebase
.firebase/
# 網站部署時才組出來的前端檔案資料夾（GitHub Pages 與 Firebase Hosting 共用）
_site/
firebase-debug.log
firestore-debug.log
ui-debug.log

# 環境變數 / 密鑰（重要！不要外洩）
.env
*.env
.runtimeconfig.json
serviceAccountKey.json

# Eiger API 探測輸出（含員工 email/姓名、客戶件名、AWS presigned URL，不可外流）
tools/_eiger_dump*/

# 文件（.md）不進版控（2026-10-13 使用者決定）：repo 是公開的，CLAUDE.md、docs/ 含內部資訊。
# 本機仍保留這些檔案（Claude Code 每次開工要讀 CLAUDE.md），備份要另外處理。
*.md

# 系統檔
.DS_Store
Thumbs.db

# 編輯器
.vscode/
.idea/

# Node（如果有用到）
node_modules/
# warp-sim 桌面工具的建置產物（venv 已由上方 **/venv/ 涵蓋）
tools/warp-sim/build/
tools/warp-sim/dist/
tools/warp-sim/*.spec

# warp-sim 產生的預覽圖
tools/warp-sim/preview*.png
tools/warp-sim/*_warp.png

# 規則測試的模擬器暫存（node_modules 已由上方涵蓋）
tools/rules-test/.firebase/
firestore-debug.log
