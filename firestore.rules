rules_version = '2';

// ════════════════════════════════════════════════════════
// SWTC Portal — Firestore Security Rules（統一 swtc-3dp-poc）
//
// 整合後 Collections：
//   users               - 使用者帳號（permissions array，相容舊 role）
//   bookings            - 3D 列印機預約（swtc-3DP 原系統）
//   inventory/main      - 庫存單一文件
//   inventory_history   - 消耗/入庫/手動調整紀錄
//   printer_status      - Cloud Function 寫入的機台狀態
//   workboard_orders    - 工作看板工單（Coffee-Who 平台）
//   issues_anomalies    - 客戶異常
//   issues_ipa          - IPA 採購
//   issues_equipment    - 設備清單
//   settings/workspace  - 平台共用設定（工程師/機台/業務/借用人清單）
//   announcements       - 公告欄（開啟系統時依角色跳顯）
//
// 權限模型（7 種細權限，存在 users/{uid}.permissions array）：
//   view_board edit_board delete_board
//   view_issues edit_issues delete_issues
//   admin（擁有一切）
// ════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function perms() {
      return isLoggedIn() ? userDoc().get('permissions', []) : [];
    }
    function legacyRole() {
      return isLoggedIn() ? userDoc().get('role', 'viewer') : 'viewer';
    }
    function hasPerm(p) {
      return isLoggedIn() && (
        perms().hasAny(['admin', p])
        || legacyRole() == 'admin'
      );
    }
    function isAdmin() {
      return hasPerm('admin');
    }
    function isLegacyEditorOrAdmin() {
      return isLoggedIn() && (
        legacyRole() == 'editor' || legacyRole() == 'admin'
        || perms().hasAny(['admin','edit_board','edit_issues'])
      );
    }
    function isDefaultAdmin() {
      return isLoggedIn() && request.auth.token.email == 'jiliao@swtc.com';
    }

    // ════════════════════════════════════════════════════════
    // 北中南分區（決策見 docs/region-split-plan.md §2）
    //   一般角色：只能讀寫自己所屬地區的資料
    //   跨區檢視／跨區編輯：由 view_all_regions / edit_all_regions 兩個權限控制
    //   （在後台「角色權限設定」勾選）；admin 一律視為兩者皆有
    // ★ 沒有 region 欄位的舊資料一律視為中部，與前端 normRegion() 一致。
    //   （既有資料已於 2026-08-21 由後台工具補上欄位，這裡的預設值是保險用的）
    // ★ 這一層是伺服器端硬邊界，不受 settings.region_mode 那個前端開關控制。
    // ════════════════════════════════════════════════════════
    function myRegion() {
      return isLoggedIn() ? userDoc().get('region', 'central') : 'central';
    }
    // 跨區權限做成「可勾選的權限」而不是綁死角色，誰能跨區由 admin 在後台
    // 「角色權限設定」決定（2026-08-21 改）。讀與寫分開，才能表達「只能看不能改」。
    // ★ 相容既有帳號：這兩個權限是後加的，既有主管的 permissions 還沒有，
    //   直接改判斷會讓他們立刻失去跨區檢視。所以「兩個權限都還沒出現在該帳號上」
    //   時退回舊判斷（持有刪除權＝主管）。admin 重新套用一次角色預設之後，
    //   該帳號就有明確值，以設定為準。與前端 regions.js 的 canViewAllRegions 一致。
    function isCrossRegionViewer() {
      return isAdmin()
        || perms().hasAny(['view_all_regions', 'edit_all_regions'])
        || (!perms().hasAny(['view_all_regions', 'edit_all_regions'])
            && perms().hasAny(['delete_board', 'delete_issues']));
    }
    // 跨區編輯「不做」舊帳號相容——它是新開放的能力（原本只有 admin 能跨區編輯），
    // 沒有人會因為改判斷而失去既有權限，所以一律以明確設定為準。
    function isCrossRegionEditor() {
      return isAdmin() || perms().hasAny(['edit_all_regions']);
    }
    // 讀：跨區者放行；其餘比對文件的 region
    // ★ isCrossRegionViewer() 不依賴 resource，可短路成 true —— 這讓跨區者的
    //   「不帶條件查詢」也能通過 Firestore 對 list 的靜態分析（已由測試證實）。
    function canReadRegion() {
      return isCrossRegionViewer()
        || resource.data.get('region', 'central') == myRegion();
    }
    // 寫（create/update）：有跨區編輯權者不受限；其餘寫入後的 region 必須是自己那區。
    // update 另外要求「原本」也是自己那區，否則等於可以把別區的資料搬過來改。
    function canWriteRegion() {
      return isCrossRegionEditor()
        || (request.resource.data.get('region', 'central') == myRegion()
            && (resource == null || resource.data.get('region', 'central') == myRegion()));
    }
    // 刪除：沒有 request.resource，只看既有文件的 region
    function canDeleteRegion() {
      return isCrossRegionEditor() || resource.data.get('region', 'central') == myRegion();
    }

    // 主管（有 manage_users 權限）可代其他使用者套用角色/停用帳號，但兩道防線都要過：
    //   1) 目標使用者「原本」不能是 admin（不可異動管理員本人）
    //   2) 寫入後的 permissions「不能」含 admin（不可把別人升級成管理員）
    // 個別權限勾選限制（只能套角色預設、不能勾細項）是前端 UserModal 的 UI 限制，
    // 規則層只把關「不能造出/異動 admin」這條硬邊界，避免過度複雜難以維護。
    // ★ 一律用 .get(欄位, 預設值)：舊資料可能只有 role 沒有 permissions，直接取欄位
    //   會讓整條規則求值失敗（結果是拒絕），造成「明明有權限卻寫不進去」的難查問題。
    function canManageOtherUser() {
      return hasPerm('manage_users')
        && !('admin' in resource.data.get('permissions', []))
        && !('admin' in request.resource.data.get('permissions', []));
    }
    function canCreateOtherUser() {
      return hasPerm('manage_users') && !('admin' in request.resource.data.get('permissions', []));
    }

    // 首次登入時前端會自助建立自己的 users 文件（3DP-BK.html / inventory.html 的
    // onAuthStateChanged）。原本 create 只檢查 uid 相符、完全不看內容，任何能登入的人
    // 都可以繞過前端、直接呼叫 Firestore API 寫 { role:'admin' } 或
    // { permissions:['admin'] } 把自己變成管理員。這裡把自助建立限制成非 admin；
    // 保底管理員帳號本身首次登入要寫 role:'admin'，用 isDefaultAdmin() 放行。
    function selfCreateIsNotAdmin() {
      return !('admin' in request.resource.data.get('permissions', []))
        && request.resource.data.get('role', 'viewer') != 'admin';
    }

    // 地區（北中南）不可自助變更：分區上線後 region 決定看得到哪一區的資料，
    // 等同於一種權限。只有 admin 或有 manage_users 的主管能透過後台改別人的 region。
    // 這裡擋的是「自己改自己」——update 規則本來就只放行 admin/manage_users，
    // 但一般使用者仍能 create 自己的文件（首次登入），所以要在 create 端也守住：
    // 自助建立時只能寫合法區碼，不能藉此把自己塞進別區。
    function selfCreateRegionOk() {
      return !('region' in request.resource.data)
        || request.resource.data.region in ['north', 'central', 'south'];
    }

    // 保底管理員：保證系統永遠至少有一位 admin。
    // Firestore rules 沒辦法「數文件」，所以不去數 admin 有幾個，改成守住指定的那一個
    // 帳號 —— 它不能被降權、停用或刪除；其他 admin 帳號仍可自由增減。
    // 前端 AdminPanel 也擋了「最後一位 admin」，但那只是 UI，直接打 API 可以繞過。
    // ⚠ 這個 email 換人時，這裡要一起改，否則會擋掉正當的異動。
    function isProtectedAdminDoc() {
      return resource != null && resource.data.get('email', '') == 'jiliao@swtc.com';
    }
    function keepsProtectedAdmin() {
      return !isProtectedAdminDoc()
        || ('admin' in request.resource.data.get('permissions', [])
            && request.resource.data.get('active', true) == true);
    }

    match /users/{userId} {
      // 讀取收緊：原本任一登入者可讀「所有人」的 email / permissions，屬內部資訊揭露。
      // 現在只放行：自己、admin、有 manage_users 的主管（後台使用者管理需要列出全部）。
      // ★ 已確認前端相依：只有 portal 的 AdminPanel 與 3DP-BK 的使用者管理 Modal
      //   會列出全部使用者，兩者本來就限 admin/manage_users；其餘頁面
      //   （quote-studio / quote-markforged / inventory / 3DP-BK 登入流程）都只讀自己那份。
      // ★ 規則內部的 get() 不受讀取規則限制，所以 hasPerm() 仍查得到別人的文件。
      allow read: if isLoggedIn() && (
        request.auth.uid == userId
        || isAdmin()
        || hasPerm('manage_users')
      );
      allow create: if isLoggedIn() && (
        (request.auth.uid == userId && selfCreateRegionOk() && (selfCreateIsNotAdmin() || isDefaultAdmin()))
        || isAdmin()
        || canCreateOtherUser()
      );
      allow update: if (isAdmin() || canManageOtherUser()) && keepsProtectedAdmin();
      allow delete: if isAdmin() && !isProtectedAdminDoc();
    }

    // 預約讀取：原本對所有登入者開放，收斂成「有 view_booking 分頁權限者」。
    // ★ 相容判斷刻意與前端 canSeeTab()（firebase-service.js）逐字對應：舊帳號的
    //   permissions 還沒有 view_booking / view_inventory 這兩個分頁權限時，維持可讀，
    //   否則升級規則會讓既有帳號突然看不到預約。
    function canSeeBookings() {
      return isLoggedIn() && (
        hasPerm('view_booking')
        || !perms().hasAny(['view_booking','view_inventory'])
      );
    }
    match /bookings/{bookingId} {
      allow read: if canSeeBookings() && canReadRegion();
      allow create, update: if isLegacyEditorOrAdmin() && canWriteRegion();
      allow delete:         if isLegacyEditorOrAdmin() && canDeleteRegion();
    }

    // 預約刪除稽核：誰、何時、刪了哪一筆（比照 inventory_history 已有的留痕作法）。
    // 由前端在刪除成功後補寫；寫進去就不能再改或刪，避免稽核紀錄本身被竄改。
    match /bookings_audit/{id} {
      allow read:   if isAdmin();
      allow create: if isLegacyEditorOrAdmin();
      allow update, delete: if false;
    }

    // inventory 底下有兩類文件：
    //   north / central / south                          → 各廠區的樹脂實體庫存
    //   markforged_north / _central / _south             → 各廠區的 Markforged 線材與耗材
    //     （以上都要比對地區）
    //   main / markforged / markforged_watch → 全域帳務、Markforged 舊單一文件與觀測基準，
    //     維持原本判斷。markforged 這個舊文件保留唯讀相容（中區分區文件建立前的來源），
    //     不再由前端寫入。
    // ★ 用 docId 判斷而不是文件裡的欄位：庫存文件的 id 就是區碼，這樣連「文件還沒
    //   被建立出來」的情況也擋得住（用欄位判斷會在 resource 為 null 時求值失敗）。
    function isRegionInvDoc(docId) {
      return docId in ['north', 'central', 'south',
                       'markforged_north', 'markforged_central', 'markforged_south'];
    }
    // 區碼：樹脂文件的 id 就是區碼；Markforged 的要去掉 'markforged_' 前綴才比對得上
    // myRegion()（回傳的是 north/central/south）。
    function invDocRegion(docId) {
      return docId.replace('markforged_', '');
    }
    match /inventory/{docId} {
      allow read: if isLoggedIn()
        && (!isRegionInvDoc(docId) || isCrossRegionViewer() || invDocRegion(docId) == myRegion());
      allow write: if isLegacyEditorOrAdmin()
        && (!isRegionInvDoc(docId) || isCrossRegionEditor() || invDocRegion(docId) == myRegion());
    }

    match /inventory_history/{logId} {
      allow read: if isLoggedIn();
      allow create: if isLegacyEditorOrAdmin();
      allow update: if isAdmin();
      // 刪除消耗紀錄（回補庫存）：admin 或主管（有 delete_board/delete_issues）都可刪，
      // 需與 inventory.html 的 canDeleteRecords() 判斷邏輯一致
      allow delete: if isAdmin() || hasPerm('delete_board') || hasPerm('delete_issues');
    }

    match /printer_status/{docId} {
      allow read: if isLoggedIn();
      allow write: if false;
    }

    // Markforged 材料餘量觀測紀錄（觀測模式，不影響庫存）。
    // 只由 Cloud Function（admin SDK，不受規則限制）寫入，比照 printer_status 全面禁寫。
    match /mf_material_log/{logId} {
      allow read: if isLoggedIn();
      allow write: if false;
    }

    match /workboard_orders/{orderId} {
      allow read: if hasPerm('view_board') && canReadRegion();
      allow create, update: if hasPerm('edit_board') && canWriteRegion();
      allow delete: if hasPerm('delete_board') && canDeleteRegion();
    }

    match /issues_anomalies/{id} {
      allow read: if hasPerm('view_issues') && canReadRegion();
      allow create, update: if hasPerm('edit_issues') && canWriteRegion();
      allow delete: if hasPerm('delete_issues') && canDeleteRegion();
    }
    match /issues_ipa/{id} {
      allow read: if hasPerm('view_issues') && canReadRegion();
      allow create, update: if hasPerm('edit_issues') && canWriteRegion();
      allow delete: if hasPerm('delete_issues') && canDeleteRegion();
    }
    match /issues_equipment/{id} {
      allow read: if hasPerm('view_issues') && canReadRegion();
      allow create, update: if hasPerm('edit_issues') && canWriteRegion();
      allow delete: if hasPerm('delete_issues') && canDeleteRegion();
    }

    // 樣品清冊：項目本身（新增/編輯/刪除）限 admin；刪除為直接刪除，不做隱藏/停用
    match /sample_items/{id} {
      allow read: if hasPerm('view_issues');
      allow create, update, delete: if isAdmin();
    }
    // 出借紀錄：開放 viewer 登記/歸還（有 view_issues 即可 create/update）；刪除限編輯者
    match /sample_loans/{id} {
      allow read: if hasPerm('view_issues');
      allow create, update: if hasPerm('view_issues');
      allow delete: if hasPerm('edit_issues');
    }

    // 公告欄：所有登入者可讀（開啟系統時跳顯），admin 或有 manage_announcements 的主管可發布/編輯/刪除
    match /announcements/{id} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isAdmin() || hasPerm('manage_announcements');
    }

    // quote-studio.html 材料/價格設定：admin 或有 manage_quote_pricing 權限的主管都可寫入
    // （必須寫在下面 settings/{docId} 泛用規則之前，Firestore rules 依路徑具體程度比對，
    //   具體路徑會蓋過萬用字元路徑，而不是兩者疊加）
    match /settings/quote_materials {
      allow read: if isLoggedIn();
      allow write: if isAdmin() || hasPerm('manage_quote_pricing');
    }
    match /settings/quote_studio_pricing {
      allow read: if isLoggedIn();
      allow write: if isAdmin() || hasPerm('manage_quote_pricing');
    }

    // settings/workspace（工程師/機台/業務/借用人清單，AdminPanel「工作看板設定」等分頁）：
    // admin 或主管都可寫入。前端 UI 本來就把這個分頁開放給主管看到並編輯、儲存按鈕沒有
    // admin-only 限制，「主管」的定義沿用前端 roleTierOf() 同一套判斷（持有 delete_board
    // 或 delete_issues）。改前只放行 isAdmin()，主管按儲存會卡在 permission-denied 且沒有
    // 任何錯誤提示（saveSettings 原本沒包 try/catch）。
    match /settings/workspace {
      allow read: if isLoggedIn();
      allow write: if isAdmin() || hasPerm('delete_board') || hasPerm('delete_issues');
    }

    match /settings/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // 3D列印估價（quote-studio.html）：估價工單與操作歷史
    match /print_orders/{id} {
      allow read, create: if isLoggedIn();
      allow update: if isLegacyEditorOrAdmin();
      allow delete: if isAdmin();
    }
    // 估價操作歷史。建立工單後，quote-studio 會刪掉該次 session 自己寫的那幾筆
    // （clearSessionHistory），所以刪除不能只放行 admin。用文件裡的 uid 認人：
    //   - create 必須把 uid 寫成自己，否則可以冒名寫紀錄、也就能反過來刪別人的
    //   - 舊紀錄沒有 uid 欄位 → .get('uid','') 取到空字串，只有 admin 刪得掉
    match /print_history/{id} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
        && request.resource.data.get('uid', '') == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isLoggedIn() && resource.data.get('uid', '') == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
